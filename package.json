{
  "name": "learnpath",
  "displayName": "LearnPath",
  "description": "Joue des parcours d'apprentissage guidés dans ton propre projet",
  "version": "0.3.0",
  "license": "MIT",
  "publisher": "Palawizard",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Palawizard/learnpath.git"
  },
  "bugs": {
    "url": "https://github.com/Palawizard/learnpath/issues"
  },
  "homepage": "https://github.com/Palawizard/learnpath#readme",
  "keywords": [
    "learning",
    "tutorial",
    "exercises",
    "vitest",
    "pytest",
    "python",
    "testing",
    "education",
    "tdd",
    "open-vsx"
  ],
  "galleryBanner": {
    "color": "#1E212B",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.learn/parcours/*.json",
    "onView:learnpath.parcours"
  ],
  "contributes": {
    "commands": [
      {
        "command": "learnpath.open",
        "title": "LearnPath: Ouvrir le parcours"
      },
      {
        "command": "learnpath.import",
        "title": "LearnPath: Importer un parcours..."
      },
      {
        "command": "learnpath.generatePrompt",
        "title": "LearnPath: Générer le prompt du parcours..."
      },
      {
        "command": "learnpath.runStep",
        "title": "LearnPath: Relancer les tests de l'étape",
        "icon": "$(debug-rerun)"
      },
      {
        "command": "learnpath.reset",
        "title": "LearnPath: Réinitialiser le parcours"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "learnpath",
          "title": "LearnPath",
          "icon": "media/activity-bar.svg"
        }
      ]
    },
    "views": {
      "learnpath": [
        {
          "id": "learnpath.parcours",
          "name": "Parcours",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "learnpath.runStep",
          "when": "view == learnpath.parcours && learnpath.active",
          "group": "navigation"
        },
        {
          "command": "learnpath.reset",
          "when": "view == learnpath.parcours && learnpath.active"
        },
        {
          "command": "learnpath.generatePrompt",
          "when": "view == learnpath.parcours"
        }
      ]
    },
    "configuration": {
      "title": "LearnPath",
      "properties": {
        "learnpath.debounceMs": {
          "type": "number",
          "default": 500,
          "description": "Délai avant lancement des tests après une sauvegarde."
        },
        "learnpath.gitCheckpoints": {
          "type": "boolean",
          "default": true,
          "description": "Enregistrer chaque étape validée dans un commit git, sous refs/learnpath/, pour pouvoir refaire une étape avec le code d'avant. Ne touche ni ta branche, ni ton index, ni ton travail en cours, et ne commite que les fichiers déclarés par l'étape. Désactivée : aucun commit n'est créé et « Refaire l'étape » est indisponible."
        },
        "learnpath.autoAdvance": {
          "type": "boolean",
          "default": true,
          "description": "Passer à l'étape suivante automatiquement quand les tests passent."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc --noEmit && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "markdown-it": "^14.3.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  }
}
